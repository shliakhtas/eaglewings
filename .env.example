# EagleWings: optional settings. Nothing here is required: all data sources are open, and the chat key
# is typed into the app by the viewer. The code does not read this file by itself; load it into the shell:
#   cp .env.example .env && set -a && . ./.env && set +a
# Never commit .env (it is in .gitignore).

# --- AI assistant (eaglewings assistant) ---
# Models used when the viewer's key is Anthropic (sk-ant-...) or OpenAI (sk-...). Defaults are in assistant/llm.py.
# ASSISTANT_ANTHROPIC_MODEL=
# ASSISTANT_OPENAI_MODEL=
# Origins allowed to call the assistant (CORS), comma-separated. Default: *
# ASSISTANT_ORIGINS=http://127.0.0.1:8766
# Sandbox for model-written code: auto (isolate the network when the OS allows), require, off
# SANDBOX_ISOLATION=auto

# --- Experiment tracking (only with --clearml) ---
# Usually ~/clearml.conf (run `clearml-init`). Environment variables work too:
# CLEARML_API_ACCESS_KEY=
# CLEARML_API_SECRET_KEY=

# --- Study scope ---
# Limit a run to some parks of the project (keys from config/regions.py), comma-separated
# GR_PARKS=dadia
